{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "before-you-do",
  "version": "0.6.2",
  "identifier": "dev.quicksay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "alwaysOnTop": true,
        "visible": false,
        "title": "before-you-do · 常用短句",
        "width": 780,
        "height": 810,
        "minWidth": 780,
        "minHeight": 680,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": false,
        "maximizable": false,
        "maxWidth": 780
      },
      {
        "label": "picker",
        "title": "before-you-do",
        "url": "index.html?picker",
        "width": 580,
        "height": 480,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false
      },
      {
        "label": "capture",
        "title": "before-you-do · Capture",
        "url": "index.html?capture-region",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": false,
        "backgroundColor": "#00000000",
        "width": 800,
        "height": 600,
        "transparent": true,
        "focus": false
      },
      {
        "label": "recording-controls",
        "title": "before-you-do · Recording",
        "url": "index.html?recording-controls",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "width": 380,
        "height": 42,
        "backgroundColor": "#242424",
        "dragDropEnabled": false
      },
      {
        "label": "materials-quick",
        "title": "before-you-do · 本次素材",
        "url": "index.html?materials-quick",
        "width": 640,
        "height": 650,
        "minWidth": 320,
        "minHeight": 360,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": false,
        "dragDropEnabled": false,
        "focusable": false
      },
      {
        "label": "capture-toast",
        "title": "before-you-do · Screenshot",
        "url": "index.html?capture-toast",
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "width": 320,
        "height": 220,
        "backgroundColor": "#202020",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
